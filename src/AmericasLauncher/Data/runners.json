[
  {
    "id": "xcl",
    "name": "XCL",
    "gitUrl": "https://github.com/xcl-dev/xcl.git",
    "dependencies": [
      {
        "name": "Git",
        "wingetId": "Git.Git",
        "check": "command:git"
      },
      {
        "name": "Visual Studio Build Tools (C++)",
        "wingetId": "Microsoft.VisualStudio.2022.BuildTools",
        "check": "vsbuildtools",
        "wingetOverride": "--wait --passive --norestart --add Microsoft.VisualStudio.Workload.VCTools --includeRecommended"
      },
      {
        "name": "Rust (rustup)",
        "wingetId": "Rustlang.Rustup",
        "check": "command:cargo"
      }
    ],
    "buildCommands": [
      "rustup toolchain install stable-x86_64-pc-windows-msvc --profile minimal",
      "cargo +stable-x86_64-pc-windows-msvc build --release --workspace"
    ],
    "exe": "target\\release\\xcl.exe",
    "launchArgs": "run \"{gameExe}\"",
    "notes": "Launch Game with XCL",
    "linux": {
      "dependencies": [ "git", "cc", "clang", "rust", "cargo-xwin" ],
      "buildCommands": [
        "rustup toolchain install stable --profile minimal --target x86_64-pc-windows-msvc --component llvm-tools",
        "cargo +stable xwin build --release -p xcl --target x86_64-pc-windows-msvc"
      ],
      "exe": "target/x86_64-pc-windows-msvc/release/xcl.exe",
      "needsDxc": true
    }
  },
  {
    "id": "VIctory-Belobug",
    "name": "Belabug - VIctory Based",
    "gitUrl": "https://github.com/Belobug/VIctory-Belobug-AMD.git",
    "dependencies": [
      {
        "name": "Git",
        "wingetId": "Git.Git",
        "check": "command:git"
      },
      {
        "name": "Visual Studio Build Tools (C++)",
        "wingetId": "Microsoft.VisualStudio.2022.BuildTools",
        "check": "vsbuildtools",
        "wingetOverride": "--wait --passive --norestart --add Microsoft.VisualStudio.Workload.VCTools --includeRecommended"
      },
      {
        "name": "Rust (rustup)",
        "wingetId": "Rustlang.Rustup",
        "check": "command:cargo"
      }
    ],
    "buildCommands": [
      "rustup toolchain install stable-x86_64-pc-windows-msvc --profile minimal",
      "cargo xtask install-hooks",               
      "copy victory.example.toml victory.toml",   
      "cargo test --workspace",                   
      "cargo run -p victory -- config", 
      "cargo build --release -p victory"
    ],
    "exe": "target\\release\\victory.exe",
    "preLaunchArgs": [
      "translate --pipelines \"{gameFolder}\\shaders.rpf\" \"{gameExe}\" \"{gameFolder}\\XboxBvhBuilder.dll\" \"{gameFolder}\\amd_fidelityfx_upscaler_xbox.dll\""
    ],
    "launchArgs": "run \"{gameExe}\" --execute",
    "notes": "Launch Game with Belabug - VIctory Based",
    "linux": {
      "dependencies": [ "git", "cc", "clang", "llvm-ml", "rust", "cargo-xwin" ],
      "buildCommands": [
        "rustup toolchain install || rustup show",
        "rustup component add llvm-tools",
        "[ -f victory.toml ] || cp victory.example.toml victory.toml",
        "cargo xwin build --release -p victory --target x86_64-pc-windows-msvc"
      ],
      "exe": "target/x86_64-pc-windows-msvc/release/victory.exe"
    }
  },
  {
    "id": "Dexnom",
    "name": "Dexnom - VIctory Based",
    "gitUrl": "https://github.com/DexNom/VIctory.git",
    "dependencies": [
      {
        "name": "Git",
        "wingetId": "Git.Git",
        "check": "command:git"
      },
      {
        "name": "Visual Studio Build Tools (C++)",
        "wingetId": "Microsoft.VisualStudio.2022.BuildTools",
        "check": "vsbuildtools",
        "wingetOverride": "--wait --passive --norestart --add Microsoft.VisualStudio.Workload.VCTools --includeRecommended"
      },
      {
        "name": "Rust (rustup)",
        "wingetId": "Rustlang.Rustup",
        "check": "command:cargo"
      }
    ],
    "buildCommands": [
      "rustup toolchain install stable-x86_64-pc-windows-msvc --profile minimal",
      "powershell -ExecutionPolicy Bypass -File Initialize-FormatTables.ps1",
      "cargo +stable-x86_64-pc-windows-msvc build --locked --release -p victory --features diagnostics --bins"
    ],
    "exe": "target\\release\\victory.exe",
    "preLaunchArgs": [
      "translate --pipelines \"{gameFolder}\\shaders.rpf\" \"{gameExe}\" \"{gameFolder}\\XboxBvhBuilder.dll\" \"{gameFolder}\\amd_fidelityfx_upscaler_xbox.dll\""
    ],
    "launchArgs": "run \"{gameExe}\" --execute",
    "notes": "Launch Game with Dexnom - VIctory Based",
    "linux": {
      "dependencies": [ "git", "cc", "clang", "llvm-ml", "rust", "cargo-xwin" ],
      "buildCommands": [
        "rustup toolchain install || rustup show",
        "rustup component add llvm-tools",
        "f=crates/victory-formats/src/bcpack-tables.bin; base=$(grep -o 'https://raw.githubusercontent.com/[^$\"]*' Initialize-FormatTables.ps1); sha=$(grep -o '[0-9A-Fa-f]\\{64\\}' Initialize-FormatTables.ps1 | head -n1); [ -f \"$f\" ] || curl -fsSL -o \"$f\" \"$base$f\"; echo \"${sha,,}  $f\" | sha256sum -c - || { rm -f \"$f\"; false; }",
        "cargo xwin build --locked --release -p victory --features diagnostics --bins --target x86_64-pc-windows-msvc"
      ],
      "exe": "target/x86_64-pc-windows-msvc/release/victory.exe"
    }
  },
