        "check": "command:cargo"
      }
    ],
    "buildCommands": [
      "rustup toolchain install stable-x86_64-pc-windows-msvc --profile minimal",
      "powershell -ExecutionPolicy Bypass -File Initialize-FormatTables.ps1",
      "cargo +stable-x86_64-pc-windows-msvc build --locked --release -p victory --features diagnostics --bins"
    ],
    "exe": "target\\release\\victory.exe",
    "preLaunchArgs": [
      "translate --pipelines \"{gameFolder}\\shaders.rpf\" \"{gameExe}\" \"{gameFolder}\\XboxBvhBuilder.dll\" \"{gameFolder}\\amd_fidelityfx_upscaler_xbox.dll\""
    ],
    "launchArgs": "run \"{gameExe}\" --execute",
    "notes": "Launch Game with Dexnom - VIctory Based"
