<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>AmericasLauncher</AssemblyName>
    <RootNamespace>AmericasLauncher</RootNamespace>
    <Version>1.5.5</Version>
    <ApplicationIcon>assets\americas-logo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Data\runners.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Resource Include="assets\logo.png" />
    <Resource Include="assets\americas-logo.ico" />
  </ItemGroup>

</Project>
