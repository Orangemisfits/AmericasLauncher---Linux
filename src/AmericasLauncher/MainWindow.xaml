<Window x:Class="AmericasLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Americas Launcher - V1.3.0"
        Icon="/assets/americas-logo.ico"
        Width="1280"
        Height="720"
        MinWidth="1024"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#191E29"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Caption Window Control Buttons -->
        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#252E42"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseCaptionButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#DC2626"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar Navigation Style -->
        <Style x:Key="NavRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root"
                                Background="Transparent"
                                CornerRadius="10"
                                BorderThickness="1"
                                BorderBrush="Transparent"
                                Padding="14,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Indicator"
                                        Grid.Column="0"
                                        Height="22"
                                        CornerRadius="2"
                                        Background="Transparent"
                                        VerticalAlignment="Center"/>
                                <ContentPresenter Grid.Column="2"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#212838"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#252E42"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#3B5998"/>
                                <Setter TargetName="Indicator" Property="Background" Value="#DC2626"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Patriot Blue Button -->
        <Style x:Key="PatriotBlueButton" TargetType="Button">
            <Setter Property="Background" Value="#1E40AF"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#3B82F6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2563EB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Patriot Crimson Launch Button -->
        <Style x:Key="PatriotRedButton" TargetType="Button" BasedOn="{StaticResource PatriotBlueButton}">
            <Setter Property="Background" Value="#B91C1C"/>
            <Setter Property="BorderBrush" Value="#EF4444"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#DC2626"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Secondary Slate Button -->
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PatriotBlueButton}">
            <Setter Property="Background" Value="#232B3B"/>
            <Setter Property="BorderBrush" Value="#3B4963"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2D374D"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Pipeline Toggle Button -->
        <Style x:Key="PipelineToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#232B3B"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="BorderBrush" Value="#3B4963"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Content" Value="Pipeline: OFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E3A8A"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="Content" Value="Pipeline: ON"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                                <Setter Property="Content" Value="Pipeline: N/A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Dark TextBox -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#141923"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderBrush" Value="#2F3B52"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Runner Card Item Container -->
        <Style x:Key="RunnerCardStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="CardBorder"
                                Background="#212838"
                                BorderBrush="#2E3A52"
                                BorderThickness="1.5"
                                CornerRadius="12"
                                Padding="14,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="4"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border x:Name="TopStripe"
                                        Grid.Row="0"
                                        CornerRadius="2"
                                        Background="#334155"
                                        Margin="0,0,0,0"/>
                                <ContentPresenter Grid.Row="1" Margin="0,10,0,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="#273044"/>
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#475B80"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="#24304A"/>
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter TargetName="TopStripe" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#DC2626" Offset="0.0"/>
                                            <GradientStop Color="#F8FAFC" Offset="0.5"/>
                                            <GradientStop Color="#2563EB" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <!-- Custom Dark Title Bar matching the UI -->
            <RowDefinition Height="36"/>
            <!-- Subtle American Flag Top Accent Line -->
            <RowDefinition Height="3"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- CUSTOM DARK TITLE BAR -->
        <Border Grid.Row="0" Background="#141822" BorderBrush="#252E42" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Image Source="/assets/logo.png" Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0"/>
                    <TextBlock Text="Americas Launcher - V1.3.0"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               Foreground="#E2E8F0"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource CaptionButtonStyle}" Click="Minimize_Click" ToolTip="Minimize">
                        <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.3"
                              Data="M0,5 L10,5"
                              Width="10" Height="10"
                              VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>
                    <Button Style="{StaticResource CaptionButtonStyle}" Click="Maximize_Click" ToolTip="Maximize / Restore">
                        <Path x:Name="MaxRestoreIcon"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.3"
                              Data="M0,0 H9 V9 H0 Z"
                              Width="10" Height="10"
                              VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>
                    <Button Style="{StaticResource CloseCaptionButtonStyle}" Click="Close_Click" ToolTip="Close">
                        <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.3"
                              Data="M0,0 L9,9 M9,0 L0,9"
                              Width="10" Height="10"
                              VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#B91C1C" Offset="0.0"/>
                    <GradientStop Color="#F8FAFC" Offset="0.5"/>
                    <GradientStop Color="#1D4ED8" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDEBAR -->
            <Border Grid.Column="0"
                    Background="#141822"
                    BorderBrush="#252E42"
                    BorderThickness="0,0,1,0"
                    Padding="18,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Top-Left Transparent Logo -->
                    <StackPanel Grid.Row="0" HorizontalAlignment="Center">
                        <Image Source="/assets/logo.png"
                               Width="96"
                               Height="96"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="AMERICAS LAUNCHER"
                                   Margin="0,12,0,2"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#F8FAFC"
                                   HorizontalAlignment="Center"/>
                        <TextBlock FontSize="11.5" HorizontalAlignment="Center">
                            <Hyperlink NavigateUri="https://github.com/isaac-btw/AmericasLauncher"
                                       Foreground="#60A5FA"
                                       RequestNavigate="Hyperlink_RequestNavigate">
                                <Run Text="Github Page"/>
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>

                    <Border Grid.Row="1" Height="1" Background="#252E42" VerticalAlignment="Center"/>

                    <!-- Navigation Items -->
                    <StackPanel Grid.Row="2">
                        <RadioButton x:Name="LaunchNavButton"
                                     Style="{StaticResource NavRadioStyle}"
                                     IsChecked="True"
                                     Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🚀" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Launch" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <!-- Port Status -->
                        <RadioButton x:Name="PortStatusNavButton"
                                     Style="{StaticResource NavRadioStyle}"
                                     Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📡" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Port Status" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="SettingsNavButton"
                                     Style="{StaticResource NavRadioStyle}"
                                     Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Settings" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <!-- Simple Launcher Version -->
                    <TextBlock Grid.Row="4"
                               x:Name="SidebarVersionText"
                               Text="v1.3.0"
                               FontSize="12"
                               Foreground="#64748B"
                               HorizontalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- RIGHT CONTENT AREA -->
            <Grid Grid.Column="1" Margin="24,20">

                <!-- VIEW 1: LAUNCH -->
                <Grid x:Name="LaunchView" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="116"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Top 5 Runner Cards (Paint boxes 1-5) -->
                    <ListBox x:Name="RunnerBox"
                             Grid.Row="0"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             ItemContainerStyle="{StaticResource RunnerCardStyle}"
                             Margin="-5,0,-5,14">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="5"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0"
                                               Text="{Binding Name}"
                                               FontSize="13.5"
                                               FontWeight="Bold"
                                               Foreground="#F8FAFC"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Row="1"
                                               Text="{Binding Notes}"
                                               FontSize="11"
                                               Foreground="#94A3B8"
                                               TextWrapping="Wrap"
                                               Margin="0,6,0,0"
                                               VerticalAlignment="Top"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Action Bar: Install/Update, Launch Game, Version, Status -->
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button x:Name="InstallButton"
                                    Style="{StaticResource PatriotBlueButton}"
                                    Content="Install / Update"
                                    Click="Install_Click"/>
                            <Button x:Name="LaunchButton"
                                    Style="{StaticResource PatriotRedButton}"
                                    Content="▶  Launch Game"
                                    Margin="10,0,0,0"
                                    Click="Launch_Click"/>
                            <ToggleButton x:Name="PipelineToggleButton"
                                          Style="{StaticResource PipelineToggleStyle}"
                                          Margin="10,0,0,0"
                                          Checked="PipelineToggle_Changed"
                                          Unchecked="PipelineToggle_Changed"/>
                        </StackPanel>

                        <TextBlock x:Name="VersionText"
                                   Grid.Column="1"
                                   Margin="18,0,12,0"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   Foreground="#CBD5E1"
                                   Text="Emulator version: -"
                                   TextTrimming="CharacterEllipsis"/>

                        <Border Grid.Column="2"
                                Background="#212838"
                                BorderBrush="#2E3A52"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,6"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="StatusText"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       Text=""/>
                        </Border>
                    </Grid>

                    <!-- Red Warning Banner when Game Folder / Exe is missing -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,12">
                        <Border x:Name="MissingPathsBanner"
                                Background="#450A0A"
                                BorderBrush="#DC2626"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14,10"
                                Margin="0,0,0,8"
                                Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚠" FontSize="14" Foreground="#FCA5A5" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Game Folder and Game Exe are not selected. Please select them in Settings."
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#FCA5A5"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Pipeline Long Wait Warning Banner -->
                        <Border x:Name="PipelineWarningBanner"
                                Background="#3B2308"
                                BorderBrush="#D97706"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14,9"
                                Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⏳" FontSize="13" Foreground="#FCD34D" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Pipeline translation is ON — this will take a long time (several minutes on first run)."
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           Foreground="#FCD34D"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Progress Bar (Paint green bar) -->
                    <ProgressBar x:Name="Progress"
                                 Grid.Row="3"
                                 Height="10"
                                 Margin="0,0,0,12"
                                 Background="#141822"
                                 Foreground="#2563EB"
                                 BorderBrush="#252E42"
                                 BorderThickness="1"/>

                    <!-- Console / Log Box (Paint large black box) -->
                    <Border Grid.Row="4"
                            Background="#0F131C"
                            BorderBrush="#273145"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="4">
                        <TextBox x:Name="LogBox"
                                 Background="Transparent"
                                 Foreground="#E2E8F0"
                                 BorderThickness="0"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas"
                                 FontSize="12.5"
                                 Padding="10"/>
                    </Border>
                </Grid>

                <!-- VIEW 2: PORT STATUS -->
                <Grid x:Name="PortStatusView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Top Attribution & Refresh -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Port Status" FontSize="22" FontWeight="Bold" Foreground="#F8FAFC"/>
                            <TextBlock FontSize="12.5" Foreground="#94A3B8" Margin="0,4,0,0">
                                <Run Text="Data is fetched live from "/>
                                <Hyperlink NavigateUri="https://portwatch-vi.xyz/"
                                           Foreground="#60A5FA"
                                           RequestNavigate="Hyperlink_RequestNavigate">
                                    <Run Text="Portwatch VI (https://portwatch-vi.xyz/)"/>
                                </Hyperlink>
                                <Run Text=" • "/>
                                <Run x:Name="PortUpdatedText" Text="Loading..."/>
                            </TextBlock>
                        </StackPanel>
                        <Button x:Name="PortRefreshButton"
                                Grid.Column="1"
                                Style="{StaticResource SecondaryButton}"
                                Content="Refresh"
                                VerticalAlignment="Center"
                                Click="PortRefresh_Click"/>
                    </Grid>

                    <!-- Overall Progress: Closest Effort to Playable -->
                    <Border Grid.Row="1"
                            Background="#212838"
                            BorderBrush="#2E3A52"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="18,16"
                            Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Overall progress · closest effort to playable"
                                               FontSize="12.5"
                                               FontWeight="SemiBold"
                                               Foreground="#94A3B8"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock x:Name="PortLeaderNameText"
                                                   Text="-"
                                                   FontSize="18"
                                                   FontWeight="Bold"
                                                   Foreground="#F8FAFC"/>
                                        <TextBlock x:Name="PortLeaderRepoText"
                                                   Text=""
                                                   FontSize="12.5"
                                                   Foreground="#60A5FA"
                                                   VerticalAlignment="Bottom"
                                                   Margin="10,0,0,2"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                    <TextBlock x:Name="PortOverallScoreText"
                                               Text="--%"
                                               FontSize="26"
                                               FontWeight="Bold"
                                               Foreground="#F8FAFC"
                                               HorizontalAlignment="Right"/>
                                    <TextBlock x:Name="PortTop3Text"
                                               Text="Top 3 avg: --%"
                                               FontSize="11.5"
                                               Foreground="#94A3B8"
                                               HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Grid>

                            <ProgressBar x:Name="PortOverallProgressBar"
                                         Height="10"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="0"
                                         Background="#141822"
                                         Foreground="#2563EB"
                                         BorderBrush="#2E3A52"
                                         BorderThickness="1"
                                         Margin="0,0,0,12"/>

                            <!-- Milestones -->
                            <ItemsControl x:Name="PortMilestonesList" Margin="0,0,0,12">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="7"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#182030"
                                                BorderBrush="#2E3A52"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Margin="3,0"
                                                Padding="6,6">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding Label}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="#E2E8F0"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="Pending"/>
                                                            <Setter Property="Foreground" Value="#64748B"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Reached}" Value="True">
                                                                    <Setter Property="Text" Value="✓ Reached"/>
                                                                    <Setter Property="Foreground" Value="#4ADE80"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 4 Quality Tracks -->
                            <UniformGrid Columns="4">
                                <Border Background="#182030" BorderBrush="#2B364D" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="Story progress" FontSize="11" Foreground="#94A3B8"/>
                                        <TextBlock x:Name="PortStoryText" Text="-" FontSize="12.5" FontWeight="SemiBold" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#182030" BorderBrush="#2B364D" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="3,0">
                                    <StackPanel>
                                        <TextBlock Text="Rendering" FontSize="11" Foreground="#94A3B8"/>
                                        <TextBlock x:Name="PortRenderText" Text="-" FontSize="12.5" FontWeight="SemiBold" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#182030" BorderBrush="#2B364D" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="3,0">
                                    <StackPanel>
                                        <TextBlock Text="Performance" FontSize="11" Foreground="#94A3B8"/>
                                        <TextBlock x:Name="PortPerfText" Text="-" FontSize="12.5" FontWeight="SemiBold" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#182030" BorderBrush="#2B364D" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="6,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Stability" FontSize="11" Foreground="#94A3B8"/>
                                        <TextBlock x:Name="PortStabilityText" Text="-" FontSize="12.5" FontWeight="SemiBold" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- What Changed News -->
                    <Border Grid.Row="2"
                            Background="#212838"
                            BorderBrush="#2E3A52"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="18,14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0"
                                       Text="What changed"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="#F8FAFC"
                                       Margin="0,0,0,10"/>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="PortChangesList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#2B364D" BorderThickness="0,0,0,1" Padding="0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="86"/>
                                                        <ColumnDefinition Width="74"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding Date}"
                                                               FontSize="11.5"
                                                               Foreground="#94A3B8"
                                                               VerticalAlignment="Center"/>
                                                    <Border Grid.Column="1"
                                                            Background="#1E3A8A"
                                                            CornerRadius="4"
                                                            Padding="6,2"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Kind}"
                                                                   FontSize="10"
                                                                   FontWeight="Bold"
                                                                   Foreground="#DBEAFE"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding Text}"
                                                               FontSize="12.5"
                                                               Foreground="#E2E8F0"
                                                               TextWrapping="Wrap"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <!-- VIEW 3: SETTINGS -->
                <ScrollViewer x:Name="SettingsView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="820" HorizontalAlignment="Left" Width="820" Margin="0,0,0,16">
                        <TextBlock Text="Settings"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#F8FAFC"/>
                        <TextBlock Text="Configure your game directory, executable path, storage, and launcher updates."
                                   FontSize="13"
                                   Foreground="#94A3B8"
                                   Margin="0,4,0,20"/>

                        <Border Background="#212838"
                                BorderBrush="#2E3A52"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="20"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <!-- Game Folder: Button on LEFT, Path on RIGHT -->
                                <TextBlock Text="Game Folder"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#CBD5E1"
                                           Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="210"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0"
                                            Style="{StaticResource PatriotBlueButton}"
                                            Content="Select Game Folder"
                                            Click="BrowseFolder_Click"/>
                                    <TextBox x:Name="GameFolderBox"
                                             Grid.Column="1"
                                             Style="{StaticResource ModernTextBox}"
                                             IsReadOnly="True"
                                             Margin="12,0,0,0"/>
                                </Grid>

                                <!-- Game Exe: Button on LEFT, Path on RIGHT -->
                                <TextBlock Text="Game Executable"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#CBD5E1"
                                           Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="210"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0"
                                            Style="{StaticResource SecondaryButton}"
                                            Content="Select Game Exe"
                                            Click="BrowseExe_Click"/>
                                    <TextBox x:Name="GameExeBox"
                                             Grid.Column="1"
                                             Style="{StaticResource ModernTextBox}"
                                             IsReadOnly="True"
                                             Margin="12,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Storage: Runners & Pipeline Cache -->
                        <Border Background="#212838"
                                BorderBrush="#2E3A52"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="20"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="Storage &amp; Cache"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Foreground="#F8FAFC"
                                               VerticalAlignment="Center"/>
                                    <Button Grid.Column="1"
                                            Style="{StaticResource SecondaryButton}"
                                            Content="Refresh Sizes"
                                            Padding="12,6"
                                            Click="RefreshStorage_Click"/>
                                </Grid>

                                <!-- Pipeline Cache Row -->
                                <Border Background="#182030"
                                        BorderBrush="#2B364D"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="14,10"
                                        Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="Pipeline / Shader Cache" FontSize="13" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                                            <TextBlock x:Name="PipelineCachePathText" Text="%LocalAppData%\victory\cache" FontSize="11" Foreground="#94A3B8"/>
                                        </StackPanel>
                                        <TextBlock x:Name="PipelineCacheSizeText"
                                                   Grid.Column="1"
                                                   Text="0 B"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="#CBD5E1"
                                                   VerticalAlignment="Center"
                                                   Margin="16,0"/>
                                        <Button x:Name="DeletePipelineCacheButton"
                                                Grid.Column="2"
                                                Style="{StaticResource PatriotRedButton}"
                                                Content="Delete Cache"
                                                Padding="12,6"
                                                Click="DeletePipelineCache_Click"/>
                                    </Grid>
                                </Border>

                                <!-- Installed Runners List -->
                                <TextBlock Text="Installed Runners"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#CBD5E1"
                                           Margin="0,0,0,8"/>
                                <ItemsControl x:Name="RunnerStorageList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#182030"
                                                    BorderBrush="#2B364D"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="14,10"
                                                    Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding Name}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Foreground="#F8FAFC"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding SizeText}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Foreground="#CBD5E1"
                                                               VerticalAlignment="Center"
                                                               Margin="16,0"/>
                                                    <Button Grid.Column="2"
                                                            Style="{StaticResource PatriotRedButton}"
                                                            Content="Delete"
                                                            Padding="12,6"
                                                            IsEnabled="{Binding CanDelete}"
                                                            Tag="{Binding Profile}"
                                                            Click="DeleteRunner_Click"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Launcher Updates Card -->
                        <Border Background="#212838"
                                BorderBrush="#2E3A52"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="CheckLauncherUpdateButton"
                                        Grid.Column="0"
                                        Style="{StaticResource PatriotBlueButton}"
                                        Content="Check for Updates"
                                        Click="CheckLauncherUpdate_Click"/>
                                <TextBlock x:Name="LauncherUpdateStatusText"
                                           Grid.Column="1"
                                           Margin="16,0,12,0"
                                           VerticalAlignment="Center"
                                           FontSize="13"
                                           Foreground="#CBD5E1"
                                           Text="Current version: v1.3.0"
                                           TextWrapping="Wrap"/>
                                <Button x:Name="OpenReleaseButton"
                                        Grid.Column="2"
                                        Style="{StaticResource PatriotRedButton}"
                                        Content="Update Now"
                                        Visibility="Collapsed"
                                        Click="OpenRelease_Click"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

            </Grid>
        </Grid>
    </Grid>
</Window>
