<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AmericasLauncher.Linux.MainWindow"
        Title="Americas Launcher (Linux) - v1.6.3"
        Width="1280" Height="720"
        MinWidth="1000" MinHeight="600"
        Background="#191E29">

    <Grid ColumnDefinitions="220,*">
        <!-- Sidebar -->
        <Border Grid.Column="0" Background="#121620" BorderBrush="#263044" BorderThickness="0,0,1,0" Padding="16">
            <Grid RowDefinitions="Auto,*,Auto">
                <StackPanel Grid.Row="0" Margin="0,12,0,24">
                    <TextBlock Text="AMERICAS LAUNCHER" FontSize="15" FontWeight="Bold" Foreground="#F8FAFC" HorizontalAlignment="Center"/>
                    <TextBlock Text="Linux Native Port" FontSize="11" Foreground="#60A5FA" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Spacing="8">
                    <Button x:Name="NavLaunchBtn" Content="🚀  Launch" HorizontalAlignment="Stretch" Height="40"
                            Background="#24304A" Foreground="#F8FAFC" Click="NavLaunch_Click"/>
                    <Button x:Name="NavSettingsBtn" Content="⚙  Settings" HorizontalAlignment="Stretch" Height="40"
                            Background="Transparent" Foreground="#94A3B8" Click="NavSettings_Click"/>
                </StackPanel>

                <TextBlock Grid.Row="2" Text="v1.6.3 (Linux)" FontSize="12" Foreground="#64748B" HorizontalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Content -->
        <Grid Grid.Column="1" Margin="20">
            <!-- Launch View -->
            <Grid x:Name="LaunchView" RowDefinitions="280,Auto,*" IsVisible="True">
                <Grid Grid.Row="0" ColumnDefinitions="3*,*" Margin="0,0,0,12">
                    <ListBox x:Name="RunnerBox" Grid.Column="0" Background="Transparent" BorderThickness="0"
                             SelectionChanged="RunnerBox_SelectionChanged" Margin="0,0,12,0">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" Rows="3"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#212838" BorderBrush="#2E3A52" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="3">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="Bold" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Notes}" FontSize="11" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Width="6" CornerRadius="3" Background="{Binding StatusColor}" Margin="6,0,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Grid Grid.Column="1" RowDefinitions="*,8,*">
                        <Border Grid.Row="0" Background="#131823" BorderBrush="#2E3A52" BorderThickness="1" CornerRadius="10" Padding="12">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Runner Status" FontSize="12" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,4"/>
                                <TextBlock x:Name="RunnerStatusLegendText" Text="Please select a runner" FontSize="11.5" Foreground="#94A3B8" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Background="#131823" BorderBrush="#2E3A52" BorderThickness="1" CornerRadius="10" Padding="12">
                            <StackPanel VerticalAlignment="Center" Spacing="6">
                                <TextBlock Text="Runner Settings" FontSize="12" FontWeight="Bold" Foreground="#F8FAFC"/>
                                <Grid ColumnDefinitions="*,6,*">
                                    <ToggleButton x:Name="PipelineToggleBtn" Grid.Column="0" Content="Pipeline: ON" IsChecked="True"
                                                  HorizontalAlignment="Stretch" Height="30" FontSize="11" Click="PipelineToggle_Click"/>
                                    <Button x:Name="ConsoleBtn" Grid.Column="2" Content="Xbox Series X"
                                            HorizontalAlignment="Stretch" Height="30" FontSize="11" Click="Console_Click"/>
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Grid.Column="0" Text="Resolution:" FontSize="11.5" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox x:Name="ResolutionBox" Grid.Column="1" HorizontalAlignment="Stretch" Height="32" SelectedIndex="2"
                                              SelectionChanged="ResolutionBox_SelectionChanged">
                                        <ComboBoxItem Content="540p"/>
                                        <ComboBoxItem Content="720p"/>
                                        <ComboBoxItem Content="1080p"/>
                                        <ComboBoxItem Content="2K"/>
                                        <ComboBoxItem Content="4K"/>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- Action Bar -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" Margin="0,0,0,12">
                    <Button x:Name="InstallBtn" Content="Install / Update" Background="#2563EB" Foreground="#FFFFFF" Height="38" Padding="18,0" Click="Install_Click"/>
                    <Button x:Name="LaunchBtn" Content="▶  Launch Game" Background="#DC2626" Foreground="#FFFFFF" Height="38" Padding="18,0" Click="Launch_Click"/>
                    <TextBlock x:Name="StatusText" Text="Ready" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>

                <!-- Console Log -->
                <Border Grid.Row="2" Background="#0F131C" BorderBrush="#263044" BorderThickness="1" CornerRadius="10" Padding="12">
                    <TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                             Background="Transparent" BorderThickness="0" Foreground="#CBD5E1" FontFamily="Monospace" FontSize="12"/>
                </Border>
            </Grid>

            <!-- Settings View -->
            <ScrollViewer x:Name="SettingsView" IsVisible="False">
                <StackPanel Spacing="16" MaxWidth="800">
                    <TextBlock Text="Settings" FontSize="22" FontWeight="Bold" Foreground="#F8FAFC"/>

                    <Border Background="#212838" BorderBrush="#2E3A52" BorderThickness="1" CornerRadius="10" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Game Paths" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC"/>
                            <Grid ColumnDefinitions="120,*,Auto">
                                <TextBlock Grid.Column="0" Text="Game Folder" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                <TextBox x:Name="GameFolderBox" Grid.Column="1" IsReadOnly="True" Margin="0,0,8,0"/>
                                <Button Grid.Column="2" Content="Browse..." Click="BrowseFolder_Click"/>
                            </Grid>
                            <Grid ColumnDefinitions="120,*,Auto">
                                <TextBlock Grid.Column="0" Text="Game Exe" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                <TextBox x:Name="GameExeBox" Grid.Column="1" IsReadOnly="True" Margin="0,0,8,0"/>
                                <Button Grid.Column="2" Content="Browse..." Click="BrowseExe_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Background="#212838" BorderBrush="#2E3A52" BorderThickness="1" CornerRadius="10" Padding="16">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Storage &amp; Cache" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="Cool Start (Reset)" Background="#DC2626" Foreground="#FFFFFF" Click="CoolStart_Click"/>
                            </Grid>
                            <TextBlock x:Name="CacheSizeText" Text="Pipeline Cache: 0 B" Foreground="#94A3B8"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
